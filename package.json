{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "check": "bun x --bun svelte-check --tsconfig ./tsconfig.app.json && bun x --bun tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
