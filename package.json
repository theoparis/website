{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "check": "bun x --bun svelte-check --tsconfig ./tsconfig.app.json && bun x --bun tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.1",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "5.55.4",
    "svelte-check": "4.4.6",
    "typescript": "6.0.3",
    "vite": "8.0.8"
  }
}
