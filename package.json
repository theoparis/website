{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "check": "bun x --bun svelte-check --tsconfig ./tsconfig.app.json && bun x --bun tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.6",
    "svelte": "5.46.4",
    "svelte-check": "4.3.5",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.0"
  }
}
